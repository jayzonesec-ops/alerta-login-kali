[Unit]
Description=SOC - Notificação única de inicialização
After=network-online.target
Wants=network-online.target
# Garante que só roda uma vez por boot
ConditionPathExists=!/run/soc-notify-boot.done

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/soc/notify_boot.py
ExecStartPost=/bin/touch /run/soc-notify-boot.done
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
